---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../utils/posts';

interface Props {
  post: CollectionEntry<'posts'>;
  activeTag?: string | null;
  hidden?: boolean;
}

const { post, activeTag = null, hidden = false } = Astro.props;
---

<li
  class="post-item"
  data-tags={JSON.stringify(post.data.tags || [])}
  style={hidden ? 'display: none;' : undefined}
>
  <span class="post-date">{formatDate(post.data.pubDate)}</span>
  <div class="post-content">
    <a href={`/posts/${post.id}`} class="post-title">
      {post.data.title}
    </a>
    {
      post.data.tags && post.data.tags.length > 0 && (
        <div class="post-tags">
          {post.data.tags.map((tag: string) => {
            const isActive = activeTag === tag;
            return (
              <a
                href={isActive ? '/posts' : `/tags/${encodeURIComponent(tag)}`}
                class:list={['post-tag', { active: isActive }]}
                data-tag={tag}
                aria-current={isActive ? 'true' : undefined}
              >
                {tag}
              </a>
            );
          })}
        </div>
      )
    }
  </div>
</li>

<style>
  .post-item {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    font-size: 0.95rem;
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .post-content {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex: 1;
    min-width: 0;
  }

  .post-title {
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .post-title:hover {
    color: var(--text-muted);
  }

  .post-tags {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
  }

  @media (max-width: 560px) {
    .post-item {
      flex-direction: column;
      gap: 0.35rem;
    }

    .post-content {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }

    .post-title {
      white-space: normal;
    }
  }
</style>
