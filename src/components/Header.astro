---
import ThemeToggle from './ThemeToggle.astro';
import { SITE_TITLE } from '../consts';

interface Props {
  siteTitle?: string;
}

const { siteTitle = SITE_TITLE } = Astro.props;

const pathname = Astro.url.pathname;
const isCurrent = (path: string) => {
  if (path === '/') return pathname === '/';
  if (path === '/posts') return pathname.startsWith('/posts') || pathname.startsWith('/tags');
  return pathname.startsWith(path);
};
---

<header class="header" transition:animate="none">
  <div class="container nav-wrapper">
    <!-- 左侧：博客名称 -->
    <div class="nav-brand">
      <a href="/" class="brand-link">{siteTitle}</a>
    </div>

    <!-- 中间：首页与文章 -->
    <nav class="nav-links">
      <a href="/" class:list={[{ active: isCurrent('/') }]}>首页</a>
      <a href="/posts" class:list={[{ active: isCurrent('/posts') }]}>文章</a>
    </nav>

    <!-- 右侧：RSS 订阅复制与浅色/深色模式切换 -->
    <div class="nav-actions">
      <button
        type="button"
        id="rss-copy-btn"
        class="action-btn"
        aria-label="复制 RSS 订阅地址"
        title="复制 RSS 订阅地址"
      >
        <svg
          class="rss-icon"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 11a9 9 0 0 1 9 9"></path>
          <path d="M4 4a16 16 0 0 1 16 16"></path>
          <circle cx="5" cy="19" r="1"></circle>
        </svg>
        <span class="rss-copied-text">已复制</span>
      </button>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 0.75rem 0;
    background-color: var(--bg);
    background-color: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .nav-wrapper {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }

  .nav-brand {
    justify-self: start;
  }

  .brand-link {
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .nav-links {
    justify-self: center;
    display: flex;
    gap: 1.5rem;
    font-size: 0.95rem;
  }

  .nav-links a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .nav-links a:hover {
    color: var(--text);
    opacity: 1;
  }

  .nav-links a.active {
    color: var(--text);
    font-weight: 500;
  }

  .nav-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.2rem;
    border-radius: var(--radius-sm, 4px);
    color: var(--text-muted);
    font-family: var(--font-sans);
    line-height: 1;
  }

  .action-btn:hover {
    color: var(--text);
  }

  .rss-copied-text {
    display: none;
    font-size: 0.75rem;
    color: var(--text);
    user-select: none;
  }

  .action-btn.copied {
    color: var(--text);
  }

  .action-btn.copied .rss-copied-text {
    display: inline;
  }
</style>

<script>
  let rssCopyTimer: number | null = null;

  function setupRssCopy() {
    const btn = document.getElementById('rss-copy-btn') as HTMLButtonElement | null;
    if (!btn || btn.dataset.rssInitialized) return;
    btn.dataset.rssInitialized = 'true';

    btn.addEventListener('click', async () => {
      const rssUrl = `${window.location.origin}/rss.xml`;
      try {
        await navigator.clipboard.writeText(rssUrl);
        btn.classList.add('copied');
        btn.setAttribute('title', '已复制 RSS 订阅地址');
        btn.setAttribute('aria-label', '已复制 RSS 订阅地址');

        if (rssCopyTimer) {
          clearTimeout(rssCopyTimer);
        }

        rssCopyTimer = window.setTimeout(() => {
          btn.classList.remove('copied');
          btn.setAttribute('title', '复制 RSS 订阅地址');
          btn.setAttribute('aria-label', '复制 RSS 订阅地址');
          rssCopyTimer = null;
        }, 2000);
      } catch (err) {
        console.error('复制 RSS 订阅地址失败:', err);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupRssCopy);
  } else {
    setupRssCopy();
  }
  document.addEventListener('astro:after-swap', setupRssCopy);
  document.addEventListener('astro:page-load', setupRssCopy);
</script>
