---
import type { CollectionEntry } from 'astro:content';
import PostItem from './PostItem.astro';
import TagFilterBar from './TagFilterBar.astro';

interface Props {
  posts: CollectionEntry<'posts'>[];
  allTags: string[];
  tagCounts: Record<string, number>;
  activeTag?: string | null;
}

const { posts, allTags, tagCounts, activeTag = null } = Astro.props;

const visiblePosts = activeTag
  ? posts.filter((post) => (post.data.tags || []).includes(activeTag))
  : posts;
---

<div class="posts-page" id="posts-page">
  <header class="page-header">
    <h1 class="page-title">文章</h1>
    <span class="posts-count" id="posts-count">共 {visiblePosts.length} 篇</span>
  </header>

  <TagFilterBar
    allTags={allTags}
    tagCounts={tagCounts}
    totalCount={posts.length}
    activeTag={activeTag}
  />

  {
    visiblePosts.length > 0 ? (
      <ul class="post-list" id="post-list">
        {visiblePosts.map((post) => (
          <PostItem post={post} activeTag={activeTag} />
        ))}
      </ul>
    ) : (
      <div id="empty-state" class="empty-state">
        暂无该标签下的文章
      </div>
    )
  }
</div>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .page-title {
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .posts-count {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .empty-state {
    margin: 3.5rem 0;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>
