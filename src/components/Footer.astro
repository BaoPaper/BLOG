---
import { SITE_AUTHOR } from '../consts';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-content">
    <span>{SITE_AUTHOR} © {year}</span>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    padding: 3rem 0 2.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .footer-content {
    display: flex;
    justify-content: center;
  }
</style>
