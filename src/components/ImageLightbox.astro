---
// 全屏极简图片视图组件：支持无闪烁切换、鼠标滚轮/手势缩放、键盘导航与无障碍焦点管理
---

<div
  id="image-lightbox"
  class="lightbox-modal"
  role="dialog"
  aria-modal="true"
  aria-label="图片视图"
  inert
>
  <div class="lightbox-backdrop"></div>

  <!-- 视口与图片承载区 -->
  <div class="lightbox-viewport" id="lightbox-viewport">
    <div class="lightbox-stage" id="lightbox-stage">
      <img id="lightbox-image" class="lightbox-img" alt="" draggable="false" />
    </div>
  </div>

  <!-- 底部悬浮控制中心与独立图注区 -->
  <div class="lightbox-bottombar">
    <div class="lightbox-caption-badge" id="lightbox-caption" hidden>
      <span class="caption-text" id="lightbox-caption-text"></span>
    </div>

    <div class="lightbox-dock" id="lightbox-dock">
      <button
        type="button"
        class="dock-btn dock-nav-btn"
        id="lightbox-btn-prev"
        title="上一张 (←)"
        aria-label="上一张图片"
      >
        <svg
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="dock-counter" id="lightbox-counter">
        <span id="lightbox-index">1</span>
        <span class="dock-sep">/</span>
        <span id="lightbox-total">1</span>
      </div>

      <button
        type="button"
        class="dock-btn dock-nav-btn"
        id="lightbox-btn-next"
        title="下一张 (→)"
        aria-label="下一张图片"
      >
        <svg
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <span class="dock-divider" id="lightbox-dock-divider"></span>

      <button
        type="button"
        class="dock-btn dock-close-btn"
        id="lightbox-btn-close"
        title="关闭 (Esc)"
        aria-label="关闭图片视图"
      >
        <svg
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  let windowAbortController: AbortController | null = null;

  function setupImageLightbox() {
    const modal = document.getElementById('image-lightbox');
    if (!modal || modal.dataset.lightboxInitialized) return;
    modal.dataset.lightboxInitialized = 'true';

    windowAbortController?.abort();
    windowAbortController = new AbortController();
    const { signal } = windowAbortController;

    const imgElement = document.getElementById('lightbox-image') as HTMLImageElement | null;
    const stage = document.getElementById('lightbox-stage');
    const viewport = document.getElementById('lightbox-viewport');
    const captionContainer = document.getElementById('lightbox-caption');
    const captionText = document.getElementById('lightbox-caption-text');
    const indexText = document.getElementById('lightbox-index');
    const totalText = document.getElementById('lightbox-total');
    const counterContainer = document.getElementById('lightbox-counter');
    const divider = document.getElementById('lightbox-dock-divider');

    const btnClose = document.getElementById('lightbox-btn-close') as HTMLButtonElement | null;
    const btnPrev = document.getElementById('lightbox-btn-prev') as HTMLButtonElement | null;
    const btnNext = document.getElementById('lightbox-btn-next') as HTMLButtonElement | null;
    const backdrop = modal.querySelector<HTMLElement>('.lightbox-backdrop');

    if (!imgElement || !stage || !viewport) return;

    const gallery = Array.from(
      document.querySelectorAll<HTMLImageElement>('.prose img:not(.link-favicon)')
    );
    if (gallery.length === 0) return;

    const MIN_SCALE = 0.5;
    const MAX_SCALE = 5;

    let currentIndex = 0;
    let isOpen = false;
    let loadSequence = 0;

    let baseWidth = 0;
    let baseHeight = 0;
    let scale = 1;
    let translateX = 0;
    let translateY = 0;

    let isDragging = false;
    let hasDragged = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let dragOriginX = 0;
    let dragOriginY = 0;

    let isPinching = false;
    let initialPinchDistance = 0;
    let initialPinchScale = 1;
    let touchStartX = 0;
    let touchStartY = 0;
    let touchStartTime = 0;

    const updateTransform = () => {
      imgElement.style.width = `${Math.round(baseWidth * scale)}px`;
      imgElement.style.height = `${Math.round(baseHeight * scale)}px`;
      stage.style.transform = `translate3d(${Math.round(translateX)}px, ${Math.round(translateY)}px, 0)`;
      viewport.style.cursor = scale > 1 ? (isDragging ? 'grabbing' : 'grab') : 'default';
    };

    const resetTransform = () => {
      scale = 1;
      translateX = 0;
      translateY = 0;
      updateTransform();
    };

    const fitImageToViewport = (naturalW: number, naturalH: number) => {
      const safeW = naturalW || window.innerWidth;
      const safeH = naturalH || window.innerHeight;

      const padX = window.innerWidth > 640 ? 40 : 20;
      const padTop = window.innerWidth > 640 ? 40 : 20;
      const padBottom = window.innerWidth > 640 ? 110 : 96;

      const availW = Math.max(window.innerWidth - padX * 2, 100);
      const availH = Math.max(window.innerHeight - padTop - padBottom, 100);

      const ratio = Math.min(availW / safeW, availH / safeH, 1);
      baseWidth = safeW * ratio;
      baseHeight = safeH * ratio;
      resetTransform();
    };

    const zoomTo = (targetScale: number, centerX: number, centerY: number) => {
      const nextScale = Math.min(Math.max(targetScale, MIN_SCALE), MAX_SCALE);
      if (Math.abs(nextScale - scale) < 0.001) return;

      if (nextScale <= 1) {
        translateX = 0;
        translateY = 0;
      } else {
        const offsetX = centerX - window.innerWidth / 2 - translateX;
        const offsetY = centerY - window.innerHeight / 2 - translateY;
        const factor = nextScale / scale;
        translateX -= offsetX * (factor - 1);
        translateY -= offsetY * (factor - 1);
      }

      scale = nextScale;
      updateTransform();
    };

    const updateToolbar = (alt: string) => {
      if (captionText) captionText.textContent = alt;
      if (captionContainer) captionContainer.hidden = !alt;

      if (indexText) indexText.textContent = String(currentIndex + 1);
      if (totalText) totalText.textContent = String(gallery.length);

      const isMulti = gallery.length > 1;
      if (btnPrev) btnPrev.style.display = isMulti ? 'inline-flex' : 'none';
      if (btnNext) btnNext.style.display = isMulti ? 'inline-flex' : 'none';
      if (counterContainer) counterContainer.style.display = isMulti ? 'inline-flex' : 'none';
      if (divider) divider.style.display = isMulti ? 'block' : 'none';
    };

    const showSlide = async (index: number) => {
      const sourceImg = gallery[index];
      if (!sourceImg) return;

      currentIndex = index;
      const seq = ++loadSequence;

      const src = sourceImg.currentSrc || sourceImg.getAttribute('src') || '';
      const alt = (sourceImg.getAttribute('alt') || sourceImg.getAttribute('title') || '').trim();

      updateToolbar(alt);

      // 先隐藏画布并清空旧图，杜绝上一张图片残影闪烁
      imgElement.style.opacity = '0';
      if (sourceImg.complete && sourceImg.naturalWidth > 0) {
        fitImageToViewport(sourceImg.naturalWidth, sourceImg.naturalHeight);
      } else {
        resetTransform();
      }

      imgElement.alt = alt;
      if (imgElement.getAttribute('src') !== src) {
        imgElement.src = src;
      }

      try {
        if (typeof imgElement.decode === 'function') {
          await imgElement.decode();
        }
      } catch {
        // 忽略 decode 异常，回退使用 naturalWidth
      }

      if (seq !== loadSequence || !isOpen) return;

      const natW = imgElement.naturalWidth || sourceImg.naturalWidth;
      const natH = imgElement.naturalHeight || sourceImg.naturalHeight;
      fitImageToViewport(natW, natH);
      imgElement.style.opacity = '1';
    };

    const openLightbox = (index: number) => {
      isOpen = true;
      modal.removeAttribute('inert');
      modal.classList.add('is-active');
      document.body.style.overflow = 'hidden';
      void showSlide(index);
      btnClose?.focus({ preventScroll: true });
    };

    const closeLightbox = () => {
      if (!isOpen) return;
      isOpen = false;
      loadSequence++;

      // 在设置 inert 前先移除内部元素焦点，彻底消除 WAI-ARIA 焦点警告
      if (modal.contains(document.activeElement)) {
        (document.activeElement as HTMLElement).blur();
      }

      modal.classList.remove('is-active');
      modal.setAttribute('inert', '');
      document.body.style.overflow = '';

      // 清空图片源与尺寸，避免下次打开时闪现旧图
      imgElement.style.opacity = '0';
      imgElement.removeAttribute('src');
      resetTransform();
    };

    const prevImage = () => {
      if (gallery.length <= 1) return;
      void showSlide((currentIndex - 1 + gallery.length) % gallery.length);
    };

    const nextImage = () => {
      if (gallery.length <= 1) return;
      void showSlide((currentIndex + 1) % gallery.length);
    };

    // 绑定正文图片点击事件
    gallery.forEach((img, idx) => {
      if (img.dataset.lightboxBound) return;
      img.dataset.lightboxBound = 'true';
      img.addEventListener('click', (e) => {
        e.preventDefault();
        openLightbox(idx);
      });
    });

    btnClose?.addEventListener('click', closeLightbox);
    backdrop?.addEventListener('click', closeLightbox);
    btnPrev?.addEventListener('click', prevImage);
    btnNext?.addEventListener('click', nextImage);

    // 鼠标双击缩放
    viewport.addEventListener('dblclick', (e) => {
      e.preventDefault();
      if (scale > 1.05) {
        resetTransform();
      } else {
        zoomTo(2, e.clientX, e.clientY);
      }
    });

    // 鼠标滚轮缩放
    viewport.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        const delta = e.deltaY < 0 ? 0.25 : -0.25;
        zoomTo(scale + delta, e.clientX, e.clientY);
      },
      { passive: false }
    );

    // 鼠标拖拽平移（仅在放大状态下启用拖拽）
    viewport.addEventListener('mousedown', (e) => {
      if (e.button !== 0) return;
      hasDragged = false;
      if (scale <= 1) return;

      isDragging = true;
      dragStartX = e.clientX;
      dragStartY = e.clientY;
      dragOriginX = translateX;
      dragOriginY = translateY;
      updateTransform();
    });

    window.addEventListener(
      'mousemove',
      (e) => {
        if (!isDragging || !isOpen) return;
        const dx = e.clientX - dragStartX;
        const dy = e.clientY - dragStartY;

        if (Math.abs(dx) > 4 || Math.abs(dy) > 4) {
          hasDragged = true;
        }

        translateX = dragOriginX + dx;
        translateY = dragOriginY + dy;
        updateTransform();
      },
      { signal }
    );

    window.addEventListener(
      'mouseup',
      () => {
        if (!isDragging) return;
        isDragging = false;
        updateTransform();
      },
      { signal }
    );

    // 点击空白背景关闭
    viewport.addEventListener('click', (e) => {
      if ((e.target === viewport || e.target === stage) && !hasDragged) {
        closeLightbox();
      }
      hasDragged = false;
    });

    // 触摸手势：双指缩放、放大后单指平移、未放大时单指左右滑动切图
    const getTouchDistance = (t1: Touch, t2: Touch) =>
      Math.hypot(t2.clientX - t1.clientX, t2.clientY - t1.clientY);

    viewport.addEventListener(
      'touchstart',
      (e) => {
        if (e.touches.length === 1) {
          isPinching = false;
          touchStartX = e.touches[0].clientX;
          touchStartY = e.touches[0].clientY;
          touchStartTime = Date.now();
          dragOriginX = translateX;
          dragOriginY = translateY;
        } else if (e.touches.length === 2) {
          isPinching = true;
          initialPinchDistance = getTouchDistance(e.touches[0], e.touches[1]);
          initialPinchScale = scale;
        }
      },
      { passive: true }
    );

    viewport.addEventListener(
      'touchmove',
      (e) => {
        if (isPinching && e.touches.length === 2 && initialPinchDistance > 0) {
          const dist = getTouchDistance(e.touches[0], e.touches[1]);
          const midX = (e.touches[0].clientX + e.touches[1].clientX) / 2;
          const midY = (e.touches[0].clientY + e.touches[1].clientY) / 2;
          zoomTo(initialPinchScale * (dist / initialPinchDistance), midX, midY);
        } else if (!isPinching && e.touches.length === 1 && scale > 1) {
          translateX = dragOriginX + (e.touches[0].clientX - touchStartX);
          translateY = dragOriginY + (e.touches[0].clientY - touchStartY);
          updateTransform();
        }
      },
      { passive: true }
    );

    viewport.addEventListener(
      'touchend',
      (e) => {
        if (isPinching && e.touches.length < 2) {
          isPinching = false;
          if (scale <= 1) resetTransform();
          return;
        }

        if (scale <= 1 && e.changedTouches.length === 1) {
          const dx = e.changedTouches[0].clientX - touchStartX;
          const dy = e.changedTouches[0].clientY - touchStartY;
          const elapsed = Date.now() - touchStartTime;

          if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.5 && elapsed < 400) {
            if (dx < 0) nextImage();
            else prevImage();
          }
        }
      },
      { passive: true }
    );

    // 窗口尺寸变化时重算基准尺寸
    window.addEventListener(
      'resize',
      () => {
        if (!isOpen) return;
        const sourceImg = gallery[currentIndex];
        const natW = imgElement.naturalWidth || sourceImg?.naturalWidth || window.innerWidth;
        const natH = imgElement.naturalHeight || sourceImg?.naturalHeight || window.innerHeight;
        fitImageToViewport(natW, natH);
      },
      { signal }
    );

    // 键盘快捷键（忽略带 Ctrl/Meta/Alt 的系统级组合键）
    window.addEventListener(
      'keydown',
      (e) => {
        if (!isOpen || e.ctrlKey || e.metaKey || e.altKey) return;

        switch (e.key) {
          case 'Escape':
            e.preventDefault();
            closeLightbox();
            break;
          case 'ArrowLeft':
          case 'a':
          case 'A':
            e.preventDefault();
            prevImage();
            break;
          case 'ArrowRight':
          case 'd':
          case 'D':
            e.preventDefault();
            nextImage();
            break;
          case '+':
          case '=':
            e.preventDefault();
            zoomTo(scale + 0.35, window.innerWidth / 2, window.innerHeight / 2);
            break;
          case '-':
          case '_':
            e.preventDefault();
            zoomTo(scale - 0.35, window.innerWidth / 2, window.innerHeight / 2);
            break;
          case '0':
            e.preventDefault();
            resetTransform();
            break;
        }
      },
      { signal }
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupImageLightbox);
  } else {
    setupImageLightbox();
  }

  document.addEventListener('astro:page-load', setupImageLightbox);
</script>

<style is:global>
  /* 极简全屏图片视图 Lightbox 样式 */
  .lightbox-modal {
    position: fixed;
    inset: 0;
    z-index: 99999;
    opacity: 0;
    pointer-events: none;
    user-select: none;
  }

  .lightbox-modal.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.94);
    z-index: 1;
  }

  .lightbox-viewport {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    touch-action: none;
  }

  .lightbox-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    transform-origin: center center;
    will-change: transform;
  }

  .lightbox-img {
    display: block;
    flex-shrink: 0;
    max-width: none !important;
    max-height: none !important;
    border-radius: var(--radius, 8px);
    pointer-events: none;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
    opacity: 0;
  }

  /* 底部悬浮控制中心与图注容器 */
  .lightbox-bottombar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 1.25rem 1.5rem 1.75rem 1.5rem;
    pointer-events: none;
  }

  /* 独立悬浮图注：轻量半透明胶囊 */
  .lightbox-caption-badge {
    pointer-events: auto;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.9);
    padding: 0.35rem 0.85rem;
    background: rgba(26, 26, 26, 0.9);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    max-width: 80vw;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    user-select: none;
  }

  .lightbox-caption-badge[hidden] {
    display: none !important;
  }

  .lightbox-caption-badge .caption-text {
    letter-spacing: 0.01em;
  }

  /* 纯粹控制中心 (Dock) */
  .lightbox-dock {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.5rem;
    background: rgba(26, 26, 26, 0.9);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    color: #ffffff;
  }

  .dock-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.85);
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
  }

  .dock-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
  }

  .dock-btn:active {
    background: rgba(255, 255, 255, 0.25);
  }

  .dock-counter {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.7);
    padding: 0 0.35rem;
    user-select: none;
    flex-shrink: 0;
  }

  .dock-sep {
    opacity: 0.4;
  }

  .dock-divider {
    width: 1px;
    height: 14px;
    background: rgba(255, 255, 255, 0.2);
    margin: 0 0.1rem;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .lightbox-bottombar {
      padding: 1rem 1rem 1.25rem 1rem;
      gap: 0.5rem;
    }

    .lightbox-caption-badge {
      max-width: 88vw;
      font-size: 0.78rem;
      padding: 0.25rem 0.7rem;
    }

    .dock-btn {
      width: 28px;
      height: 28px;
    }

    .dock-counter {
      font-size: 0.75rem;
    }
  }
</style>
