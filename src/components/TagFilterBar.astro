---
interface Props {
  allTags: string[];
  tagCounts: Record<string, number>;
  totalCount: number;
  activeTag?: string | null;
}

const { allTags, tagCounts, totalCount, activeTag = null } = Astro.props;
---

{
  allTags.length > 0 && (
    <nav class="tag-filter-bar" aria-label="标签筛选" id="tag-filter-bar">
      <a
        href="/posts"
        class={`tag-chip ${!activeTag ? 'active' : ''}`}
        data-tag="all"
        aria-current={!activeTag ? 'true' : undefined}
      >
        全部
        <span class="tag-count">{totalCount}</span>
      </a>
      {allTags.map((tag) => (
        <a
          href={`/tags/${encodeURIComponent(tag)}`}
          class={`tag-chip ${activeTag === tag ? 'active' : ''}`}
          data-tag={tag}
          aria-current={activeTag === tag ? 'true' : undefined}
        >
          {tag}
          <span class="tag-count">{tagCounts[tag]}</span>
        </a>
      ))}
    </nav>
  )
}

<style>
  .tag-filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .tag-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--text-muted);
    background-color: transparent;
    transition: all 0.15s ease;
    cursor: pointer;
    text-decoration: none;
    line-height: 1.4;
  }

  .tag-chip:hover {
    color: var(--text);
    border-color: rgba(128, 128, 128, 0.35);
    background-color: var(--code-bg);
    opacity: 1;
  }

  .tag-chip.active {
    color: var(--text);
    border-color: rgba(128, 128, 128, 0.4);
    background-color: rgba(128, 128, 128, 0.14);
    font-weight: 500;
  }

  .tag-count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    margin-left: 0.35rem;
    opacity: 0.7;
  }
</style>
