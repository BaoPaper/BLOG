---
import { ClientRouter, fade } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;

// 排除首页或未传标题时直接显示品牌名，其他页面显示 "页面名 · Bao's Paper"
const pageTitle =
  !title || title === '首页' || title === SITE_TITLE
    ? SITE_TITLE
    : `${title} | ${SITE_TITLE}`;
---

<!doctype html>
<html lang="zh-CN" transition:animate={fade({ duration: '0.18s' })}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href="/rss.xml"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <ClientRouter />

    <script is:inline>
      (function () {
        function getTheme() {
          try {
            if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
              return localStorage.getItem('theme');
            }
          } catch {}
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            return 'dark';
          }
          return 'light';
        }

        document.documentElement.setAttribute('data-theme', getTheme());

        if (!window.__themeTransitionInitialized) {
          window.__themeTransitionInitialized = true;
          document.addEventListener('astro:before-swap', function (e) {
            const currentTheme =
              document.documentElement.getAttribute('data-theme') || getTheme();
            e.newDocument.documentElement.setAttribute('data-theme', currentTheme);
          });
        }
      })();
    </script>
  </head>
  <body>
    <Header siteTitle={SITE_TITLE} />
    <main class="container main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .main-content {
    flex: 1;
    padding-top: 2rem;
    padding-bottom: 2rem;
  }
</style>
