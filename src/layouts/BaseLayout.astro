---
import { ClientRouter, fade } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;

// 排除首页或未传标题时直接显示品牌名，其他页面显示 "页面名 · Bao's Paper"
const pageTitle =
  !title || title === '首页' || title === SITE_TITLE
    ? SITE_TITLE
    : `${title} | ${SITE_TITLE}`;
---

<!doctype html>
<html lang="zh-CN" transition:animate={fade({ duration: '0.18s' })}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href="/rss.xml"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <ClientRouter />

    <script is:inline>
      (function () {
        function getPreference() {
          try {
            var stored = localStorage.getItem('theme');
            if (stored === 'light' || stored === 'dark' || stored === 'auto') {
              return stored;
            }
          } catch (e) {}
          return 'auto';
        }

        function resolveTheme(preference) {
          if (preference === 'light') return 'light';
          if (preference === 'dark') return 'dark';
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }

        function applyTheme() {
          var pref = getPreference();
          var resolved = resolveTheme(pref);
          document.documentElement.setAttribute('data-theme-preference', pref);
          document.documentElement.setAttribute('data-theme', resolved);
        }

        applyTheme();

        // 监听系统主题变化：在偏好为 auto 时即时跟随
        if (!window.__themeMediaListenerInitialized) {
          window.__themeMediaListenerInitialized = true;
          var mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
          mediaQuery.addEventListener('change', function (e) {
            var pref = document.documentElement.getAttribute('data-theme-preference') || 'auto';
            if (pref === 'auto') {
              document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light');
            }
          });
        }

        // Astro 页面过渡（ClientRouter）时保持主题属性
        if (!window.__themeTransitionInitialized) {
          window.__themeTransitionInitialized = true;
          document.addEventListener('astro:before-swap', function (e) {
            var currentTheme = document.documentElement.getAttribute('data-theme');
            var currentPref = document.documentElement.getAttribute('data-theme-preference');
            if (currentTheme) {
              e.newDocument.documentElement.setAttribute('data-theme', currentTheme);
            }
            if (currentPref) {
              e.newDocument.documentElement.setAttribute('data-theme-preference', currentPref);
            }
          });
        }
      })();
    </script>
  </head>
  <body>
    <Header siteTitle={SITE_TITLE} />
    <main class="container main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .main-content {
    flex: 1;
    padding-top: 2rem;
    padding-bottom: 2rem;
  }
</style>
