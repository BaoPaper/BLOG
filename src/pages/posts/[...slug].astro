---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageLightbox from '../../components/ImageLightbox.astro';
import CodeCopy from '../../components/CodeCopy.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) => {
  return date.toISOString().split('T')[0];
};

const getWordCount = (content: string = '') => {
  const clean = content.replace(/^---[\s\S]*?---/, '');
  const chineseChars = clean.match(/[\u4e00-\u9fa5]/g) || [];
  const englishWords = clean
    .replace(/[\u4e00-\u9fa5]/g, ' ')
    .replace(/[#*`~>_[\]()!+-=]/g, ' ')
    .match(/[a-zA-Z0-9_-]+/g) || [];
  return chineseChars.length + englishWords.length;
};

// 优先使用 frontmatter 中显式声明的静态字数；若未指定则在构建阶段静态估算，客户端 0 JS 运行
const wordCount = post.data.words ?? getWordCount(post.body);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="post-article">
    <header class="article-header">
      <h1 class="article-title">{post.data.title}</h1>
      {
        post.data.description && (
          <p class="article-subtitle">{post.data.description}</p>
        )
      }
      <div class="article-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        {
          wordCount !== undefined && (
            <>
              <span class="meta-dot">·</span>
              <span>{wordCount.toLocaleString()} 字</span>
            </>
          )
        }
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  <ImageLightbox />
  <CodeCopy />
</BaseLayout>

<style>
  .article-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .article-title {
    font-size: 1.8rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .article-subtitle {
    margin-top: 0.6rem;
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .article-meta {
    margin-top: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .meta-dot {
    opacity: 0.6;
  }
</style>
