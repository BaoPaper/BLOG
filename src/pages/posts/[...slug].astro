---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageLightbox from '../../components/ImageLightbox.astro';
import CodeCopy from '../../components/CodeCopy.astro';
import { formatDate, getWordCount, sortPostsByDate } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const sortedPosts = sortPostsByDate(posts);
  return sortedPosts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: sortedPosts[index - 1] ?? null,
      nextPost: sortedPosts[index + 1] ?? null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);

// 优先使用 frontmatter 中显式声明的静态字数；若未指定则在构建阶段静态估算，客户端 0 JS 运行
const wordCount = post.data.words ?? getWordCount(post.body);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="post-article">
    <header class="article-header">
      <h1 class="article-title">{post.data.title}</h1>
      {
        post.data.description && (
          <p class="article-subtitle">{post.data.description}</p>
        )
      }
      <div class="article-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        {
          post.data.updatedDate && (
            <>
              <span class="meta-dot">·</span>
              <span class="updated-date">
                更新于{' '}
                <time datetime={post.data.updatedDate.toISOString()}>
                  {formatDate(post.data.updatedDate)}
                </time>
              </span>
            </>
          )
        }
        {
          wordCount !== undefined && (
            <>
              <span class="meta-dot">·</span>
              <span>{wordCount.toLocaleString()} 字</span>
            </>
          )
        }
        {
          post.data.tags && post.data.tags.length > 0 && (
            <>
              <span class="meta-dot">·</span>
              <span class="article-tags">
                {post.data.tags.map((tag: string) => (
                  <a href={`/tags/${encodeURIComponent(tag)}`} class="post-tag">
                    {tag}
                  </a>
                ))}
              </span>
            </>
          )
        }
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      (prevPost || nextPost) && (
        <nav class="post-nav" aria-label="文章导航">
          {prevPost ? (
            <a href={`/posts/${prevPost.id}`} class="post-nav-item prev">
              <span class="post-nav-label">← 上一篇</span>
              <span class="post-nav-title">{prevPost.data.title}</span>
            </a>
          ) : (
            <div class="post-nav-placeholder" aria-hidden="true" />
          )}
          {nextPost ? (
            <a href={`/posts/${nextPost.id}`} class="post-nav-item next">
              <span class="post-nav-label">下一篇 →</span>
              <span class="post-nav-title">{nextPost.data.title}</span>
            </a>
          ) : (
            <div class="post-nav-placeholder" aria-hidden="true" />
          )}
        </nav>
      )
    }
  </article>

  <ImageLightbox />
  <CodeCopy />
</BaseLayout>

<style>
  .article-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .article-title {
    font-size: 1.8rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .article-subtitle {
    margin-top: 0.6rem;
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .article-meta {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .article-tags {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  .meta-dot {
    opacity: 0.6;
  }

  .post-nav {
    margin-top: 3.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .post-nav-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius, 8px);
    background-color: var(--bg);
    text-decoration: none;
    min-width: 0;
  }

  .post-nav-item:hover {
    background-color: var(--code-bg);
    border-color: rgba(128, 128, 128, 0.32);
    opacity: 1;
  }

  .post-nav-item.next {
    text-align: right;
    align-items: flex-end;
  }

  .post-nav-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .post-nav-title {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100%;
  }

  @media (max-width: 560px) {
    .post-nav {
      grid-template-columns: 1fr;
    }

    .post-nav-placeholder {
      display: none;
    }

    .post-nav-item.next {
      text-align: left;
      align-items: flex-start;
    }
  }
</style>
