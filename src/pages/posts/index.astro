---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostsView from '../../components/PostsView.astro';
import { sortPostsByDate, getTagStats } from '../../utils/posts';

const posts = await getCollection('posts');
const sortedPosts = sortPostsByDate(posts);
const { tagCounts, allTags } = getTagStats(sortedPosts);
---

<BaseLayout title="文章" description="所有文章列表">
  <PostsView
    posts={sortedPosts}
    allTags={allTags}
    tagCounts={tagCounts}
  />
</BaseLayout>
