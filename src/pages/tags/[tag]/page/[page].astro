---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PostsView from '../../../../components/PostsView.astro';
import { sortPostsByDate, getTagStats } from '../../../../utils/posts';
import { POSTS_PER_PAGE } from '../../../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const sortedPosts = sortPostsByDate(posts);
  const { tagCounts, allTags } = getTagStats(sortedPosts);

  return allTags.flatMap((tag) => {
    const tagPostCount = tagCounts[tag] || 0;
    const totalPages = Math.max(1, Math.ceil(tagPostCount / POSTS_PER_PAGE));

    return Array.from({ length: totalPages }, (_, index) => {
      const currentPage = index + 1;
      return {
        params: { tag, page: String(currentPage) },
        props: {
          tag,
          currentPage,
          sortedPosts,
          allTags,
          tagCounts,
        },
      };
    });
  });
}

const { tag, currentPage, sortedPosts, allTags, tagCounts } = Astro.props;

if (currentPage === 1) {
  return Astro.redirect(`/tags/${encodeURIComponent(tag)}`);
}
---

<BaseLayout
  title={`标签: ${tag} - 第 ${currentPage} 页`}
  description={`包含“${tag}”标签的所有文章 - 第 ${currentPage} 页`}
>
  <PostsView
    posts={sortedPosts}
    allTags={allTags}
    tagCounts={tagCounts}
    activeTag={tag}
    currentPage={currentPage}
  />
</BaseLayout>
