---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostsView from '../../components/PostsView.astro';
import { sortPostsByDate, getTagStats } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const sortedPosts = sortPostsByDate(posts);
  const { tagCounts, allTags } = getTagStats(sortedPosts);

  return allTags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      sortedPosts,
      allTags,
      tagCounts,
    },
  }));
}

const { tag, sortedPosts, allTags, tagCounts } = Astro.props;
---

<BaseLayout title={`标签: ${tag}`} description={`包含“${tag}”标签的所有文章`}>
  <PostsView
    posts={sortedPosts}
    allTags={allTags}
    tagCounts={tagCounts}
    activeTag={tag}
  />
</BaseLayout>
