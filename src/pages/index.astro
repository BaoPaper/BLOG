---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import PostItem from '../components/PostItem.astro';
import { sortPostsByDate } from '../utils/posts';

const posts = await getCollection('posts');
const recentPosts = sortPostsByDate(posts).slice(0, 5);
---

<BaseLayout title="首页">
  <section class="intro">
    <h1 class="intro-title">你好，欢迎来到这里。</h1>
    <p class="intro-desc">
      这是一个保持克制、专注于阅读体验的极简空间。记录思考、技术与生活。
    </p>
  </section>

  <section class="recent-section">
    <div class="section-header">
      <span class="section-title">近期文章</span>
      <a href="/posts" class="more-link">全部文章 →</a>
    </div>

    <ul class="post-list">
      {recentPosts.map((post) => <PostItem post={post} />)}
    </ul>
  </section>
</BaseLayout>

<style>
  .intro {
    margin-bottom: 3.5rem;
  }

  .intro-title {
    font-size: 1.4rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }

  .intro-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .recent-section {
    margin-top: 2rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .section-title {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .more-link {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .more-link:hover {
    color: var(--text);
  }

  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
</style>
