---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const recentPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const formatDate = (date: Date) => {
  return date.toISOString().split('T')[0];
};
---

<BaseLayout title="首页">
  <section class="intro">
    <h1 class="intro-title">你好，欢迎来到这里。</h1>
    <p class="intro-desc">
      这是一个保持克制、专注于阅读体验的极简空间。记录思考、技术与生活。
    </p>
  </section>

  <section class="recent-section">
    <div class="section-header">
      <span class="section-title">近期文章</span>
      <a href="/posts" class="more-link">全部文章 →</a>
    </div>

    <ul class="post-list">
      {
        recentPosts.map((post) => (
          <li class="post-item">
            <span class="post-date">{formatDate(post.data.pubDate)}</span>
            <a href={`/posts/${post.id}`} class="post-title">
              {post.data.title}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .intro {
    margin-bottom: 3.5rem;
  }

  .intro-title {
    font-size: 1.4rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }

  .intro-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .recent-section {
    margin-top: 2rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .section-title {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .more-link {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .more-link:hover {
    color: var(--text);
  }

  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .post-item {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    font-size: 0.95rem;
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .post-title {
    color: var(--text);
  }

  .post-title:hover {
    color: var(--text-muted);
  }

  @media (max-width: 480px) {
    .post-item {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
