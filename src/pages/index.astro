---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import PostItem from '../components/PostItem.astro';
import { sortPostsByDate } from '../utils/posts';

const posts = await getCollection('posts');
const recentPosts = sortPostsByDate(posts).slice(0, 5);
---

<BaseLayout title="首页">
  <section class="intro">
    <h1 class="intro-title">
      <img
        src="/baopaper.svg"
        alt="BaoPaper"
        width="32"
        height="32"
        decoding="async"
        class="intro-logo"
      />
      <span>你好，欢迎来到这里。</span>
    </h1>
    <p class="intro-desc">
      我是豹纸嗷列巴「BaoPaper」，这里主要记录一些我的折腾记录，因为很多都是随笔所以很多文章都比较简略，所以其实更像一个日记本吧，博客名就是 Bao's Paper 哦！
    </p>
  </section>

  <section class="recent-section">
    <div class="section-header">
      <span class="section-title">近期文章</span>
      <a href="/posts" class="more-link">全部文章 →</a>
    </div>

    <ul class="post-list">
      {recentPosts.map((post) => <PostItem post={post} />)}
    </ul>
  </section>
</BaseLayout>

<style>
  .intro {
    margin-bottom: 3.5rem;
  }

  .intro-title {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.35;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }

  .intro-logo {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    flex-shrink: 0;
    background-color: var(--code-bg);
    user-select: none;
  }

  .intro-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .recent-section {
    margin-top: 2rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .section-title {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .more-link {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .more-link:hover {
    color: var(--text);
  }

  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
</style>
